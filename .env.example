# Copie para .env.local (computador) e preencha. Na Vercel: Settings > Environment Variables.
# NUNCA coloque chaves de verdade neste arquivo (ele vai para o GitHub).

# ---- Supabase (o mesmo projeto é usado pelo mvp.cmkcogit.com.br) ----
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # só no servidor

# ---- Endereços ----
APP_URL=https://app.cmkcogit.com.br
PUBLIC_URL=                           # no computador: URL https do túnel (webhook do Mercado Pago)
SITE_URL=https://www.cmkcogit.com.br
MVP_URL=https://mvp.cmkcogit.com.br       # login único (no computador: http://localhost:3001)
MVP_ORIGENS=https://mvp.cmkcogit.com.br   # CORS das rotas /api/mvp e /api/jornada (separe por vírgula)

# ---- Mercado Pago ----
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=                    # com ele, aviso sem assinatura válida é recusado

# ---- IA ----
GROQ_API_KEY=                         # resumo grátis, mensagens e assistente (etapas baratas)
GROQ_MODEL=
GROQ_API_KEY_ASSISTENTE=
GROQ_PRECO_ENTRADA=0                  # US$ por milhão de tokens (0 no plano gratuito)
GROQ_PRECO_SAIDA=0
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=                    # documento detalhado pago (só no servidor)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium                  # low | medium | high
CLAUDE_TIMEOUT_MS=240000
# Preço do modelo acima em US$ por milhão de tokens (confira em platform.claude.com/docs/en/about-claude/pricing)
CLAUDE_PRECO_ENTRADA=4
CLAUDE_PRECO_SAIDA=20
CLAUDE_PRECO_CACHE_LEITURA=0.2
CLAUDE_PRECO_CACHE_ESCRITA=5
CLAUDE_PRECOS_JSON=                   # opcional, outros modelos: {"claude-opus-4-8":{"entrada":5,"saida":25,"cache_leitura":0.5,"cache_escrita":6.25}}
USD_BRL=5.40                          # só para o custo do resumo grátis; o do documento vem de mvp_pricing_config
JORNADA_VALOR_HORA=

# ---- Captcha (Cloudflare Turnstile): a chave SECRETA vai só no painel do Supabase ----
TURNSTILE_SITE_KEY=

# ---- Rotina diária e e-mails ----
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
WHATSAPP_SUPORTE=5517981568889
